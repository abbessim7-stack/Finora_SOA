# Copier ce fichier en .env (ignoré par Git) et adapter les valeurs.
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Finora_db

# Secret de signature des jetons JWT — remplacer par une valeur longue et aléatoire.
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_EXPIRES_IN=2h

# Origines autorisées pour le frontend (séparées par des virgules).
CORS_ORIGIN=http://127.0.0.1:5300
